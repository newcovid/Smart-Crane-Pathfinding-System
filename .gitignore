# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd
*.dll

# Virtual environment directories
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# PyInstaller
*.manifest
*.spec

# Static analysis caches
.mypy_cache/
.pyre/
.pytype/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs and editors
.vscode/
.vs/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
# Environment / secrets
.env
.env.*
secrets.json

# Node (if used) and frontend build artifacts
node_modules/
static/dist/
static/build/

# Editor temporary files
*~
*.swp

# Wheelhouse
wheelhouse/

# Coverage/lcov reports
coverage/
lcov-report/

# Misc
*.egg-info/

# Project-specific
# Rust / Cargo build artifacts
/target/
**/target/
target/**

# Compiled artifacts (Windows/Rust)
*.exe
*.rlib
*.pdb

# Dependency/temp files produced during Rust builds
*.d

# 编译产物一律不入库。Rust 扩展请用 `maturin develop --release` 本地构建，
# 或从 Releases 下载对应 Python 版本的 wheel。
# （曾经用 `!/smart_crane_core.pyd` 把编译好的扩展提交进仓库，
#   结果是它只在编译时那个 Python 小版本下可导入，换个版本就报
#   "DLL load failed"，反而比没有更糟。）
