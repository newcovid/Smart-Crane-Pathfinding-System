# 仓库内统一以 LF 存储，检出时由各平台自行处理。
# 避免 Windows 与 Linux 协作时整文件被判为改动。
* text=auto eol=lf

# Windows 专用脚本必须保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源不做任何换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pyd    binary
*.so     binary
*.dll    binary
*.pdf    binary

# 第三方前端资源不参与语言统计，也不在 diff 中展开
static/vendor/**  linguist-vendored
Cargo.lock        linguist-generated
